{
  "name": "poketoken-lite",
  "version": "0.1.0",
  "description": "Claude Code 토큰 사용량으로 포켓몬 키우기 (Windows 트레이 앱, 개인용 MVP)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build-data": "node scripts/build-pokedex-data.js",
    "build-icon": "electron scripts/build-icon.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kxoxxy.poketoken-lite",
    "productName": "PokeTokenLite",
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "data/**/*",
      "assets/**/*"
    ]
  }
}
